# =========================================================
# Montageservice Finta – Apache-Konfiguration
# Wird beim Build nach dist/.htaccess kopiert.
# =========================================================

Options -Indexes -MultiViews
DirectoryIndex index.html
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS + Hauptdomain ohne www erzwingen.
  # Erst aktivieren, wenn das SSL-Zertifikat aktiv ist. Bei Hostern mit
  # vorgeschaltetem Proxy ggf. %{HTTP:X-Forwarded-Proto} statt %{HTTPS}
  # prüfen, sonst droht eine Weiterleitungsschleife.
  # RewriteCond %{HTTPS} !=on [OR]
  # RewriteCond %{HTTP_HOST} ^www\. [NC]
  # RewriteRule ^ https://montagefinta.de%{REQUEST_URI} [L,R=301]

  # /seite.html und /index -> saubere URL (nur echte Client-Anfragen)
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [L,R=301]
  RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?] [NC]
  RewriteRule ^ / [L,R=301]

  # Abschließenden Slash entfernen (außer für echte Verzeichnisse)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [L,R=301]

  # /seite -> /seite.html intern ausliefern
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# Sensible Dateien niemals ausliefern
<FilesMatch "^(mail-config.*\.php|composer\.(json|lock)|\.env.*|.*\.(md|log|ini|sh))$">
  Require all denied
</FilesMatch>

# ---------------------------------------------------------
# Security-Header
# (Script-/Style-Hashes kommen per <meta> CSP aus dem Build)
# ---------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # Ergänzt die <meta>-CSP (script-src/style-src mit Hashes).
  # Bewusst KEIN default-src: Beide Policies gelten gleichzeitig, ein
  # default-src hier würde die gehashten Inline-Skripte blockieren.
  Header always set Content-Security-Policy "img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"

  # Erst aktivieren, wenn HTTPS dauerhaft und fehlerfrei läuft:
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Gehashte Build-Assets dürfen lange gecacht werden
  <FilesMatch "\.(js|css|avif|webp|jpe?g|png|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Nicht gehashte Dateien im Root (favicon) kürzer cachen
<IfModule mod_headers.c>
  <FilesMatch "^favicon\.(ico|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>

<section class="hero">
  <div class="hero-background">
    <div class="hero-image"></div>
  </div>

  <div class="hero-content">
    <div class="hero-eyebrow">
      <span></span>
      Küchen · Möbel · Türen
    </div>

    <h1>
      Präzision,<br />
      <em>die man sieht.</em>
    </h1>

    <div class="hero-bottom">
      <p>
        Professionelle Montage mit einem Auge fürs Detail.
        Sauber ausgeführt, zuverlässig umgesetzt.
      </p>

      <a href="#kontakt" class="hero-button">
        <span>Projekt anfragen</span>

        <span class="arrow">
          ↗
        </span>
      </a>
    </div>
  </div>

  <div class="hero-index">
    <span>01</span>
    <span class="line"></span>
    <span>Montageservice Finta</span>
  </div>

  <div class="scroll-indicator">
    <span>Scroll</span>

    <div class="scroll-line">
      <div></div>
    </div>
  </div>
</section>

<script>
  const heroImage = document.querySelector(".hero-image");

  if (heroImage) {
    let ticking = false;

    const updateHero = () => {
      if (window.innerWidth <= 900) {
        heroImage.style.setProperty(
          "--hero-shift",
          "0px"
        );

        ticking = false;
        return;
      }

      const scrollY = window.scrollY;
      const shift = Math.min(scrollY * 0.16, 110);

      heroImage.style.setProperty(
        "--hero-shift",
        `${shift}px`
      );

      ticking = false;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          window.requestAnimationFrame(updateHero);
          ticking = true;
        }
      },
      { passive: true }
    );
  }
</script>


---
import { Picture } from "astro:assets";
import Icon from "./ui/Icon.astro";
import { images } from "../data/site";
---

<section class="hero surface-dark on-dark" aria-labelledby="hero-title">
  <div class="hero-media" aria-hidden="true">
    <Picture
      src={images.hero}
      alt=""
      formats={["avif", "webp"]}
      widths={[640, 960, 1280, 1600, 2048]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="hero-image"
    />
  </div>

  <div class="container hero-content">
    <h1 class="hero-kicker" id="hero-title">
      Küchenmontage · Möbelmontage · Türen &amp; Zargen
    </h1>

    <p class="display-xl hero-claim">
      Präzision,<br />
      <em>die man sieht.</em>
    </p>

    <div class="hero-bottom">
      <p class="lead">
        Montageservice Finta montiert Küchen, Möbel, Türen und Zargen mit
        einem genauen Blick fürs Detail – sauber ausgeführt und zuverlässig
        umgesetzt.
      </p>

      <div class="hero-actions">
        <a href="/anfrage" class="btn btn--sand">
          Montage anfragen
          <span class="btn__icon"><Icon name="arrow-up-right" size={16} /></span>
        </a>
        <a href="#leistungen" class="text-link">
          Leistungen ansehen
          <Icon name="arrow-down" size={16} />
        </a>
      </div>
    </div>

    <ul class="hero-facts" aria-label="Ihre Vorteile">
      <li><Icon name="check" size={16} /> Unverbindliche Anfrage</li>
      <li><Icon name="check" size={16} /> Fotos direkt mitsenden</li>
      <li><Icon name="check" size={16} /> Persönliche Rückmeldung</li>
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .hero-media {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: #25231f;
  }

  .hero-media::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(15 15 14 / 0.88) 0%, rgb(15 15 14 / 0.6) 45%, rgb(15 15 14 / 0.25) 100%),
      linear-gradient(180deg, rgb(15 15 14 / 0.35) 0%, rgb(15 15 14 / 0) 30%, rgb(15 15 14 / 0.7) 100%);
  }

  .hero-media :global(picture) {
    display: block;
    height: 100%;
  }

  .hero-media :global(.hero-image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% center;
    animation: hero-zoom 1.8s var(--ease-out) both;
  }

  .hero-content {
    padding-top: calc(var(--header-height) + 48px);
    padding-bottom: clamp(56px, 9vh, 112px);
  }

  .hero-kicker {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 28px;
    color: var(--color-sand);
    font-size: var(--fs-label);
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .hero-kicker::before {
    content: "";
    flex: none;
    width: 40px;
    height: 1px;
    background: currentColor;
  }

  .hero-claim {
    max-width: 11ch;
  }

  .hero-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px 64px;
    max-width: 980px;
    margin-top: clamp(36px, 5vw, 64px);
  }

  .hero-bottom .lead {
    max-width: 30em;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 32px;
  }

  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 32px;
    margin-top: clamp(40px, 6vw, 72px);
    padding-top: 24px;
    border-top: 1px solid var(--color-on-dark-line);
    list-style: none;
    color: var(--color-on-dark-muted);
    font-size: var(--fs-small);
  }

  .hero-facts li {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .hero-facts :global(.icon) {
    color: var(--color-sand);
  }

  @keyframes hero-zoom {
    from {
      opacity: 0;
      transform: scale(1.06);
    }
  }

  @media (max-width: 640px) {
    .hero-media :global(.hero-image) {
      object-position: 62% center;
    }

    .hero-media::after {
      background: linear-gradient(180deg, rgb(15 15 14 / 0.55) 0%, rgb(15 15 14 / 0.55) 40%, rgb(15 15 14 / 0.88) 100%);
    }

    .hero-actions {
      width: 100%;
    }

    .hero-actions .btn {
      width: 100%;
    }

    .hero-facts {
      flex-direction: column;
    }
  }
</style>

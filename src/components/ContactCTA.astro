---
import Icon from "./ui/Icon.astro";
import { site, telHref } from "../data/site";
---

<section class="section contact" id="kontakt" aria-labelledby="kontakt-title">
  <div class="container contact-inner" data-reveal>
    <p class="eyebrow">Kontakt</p>

    <h2 class="display-xl" id="kontakt-title">
      Haben Sie ein<br />
      <em>Projekt geplant?</em>
    </h2>

    <p class="contact-lead">
      Erzählen Sie uns von Ihrem Vorhaben – am besten mit ein paar Fotos.
      Wir melden uns persönlich bei Ihnen und besprechen die nächsten
      Schritte.
    </p>

    <div class="contact-actions">
      <a href="/anfrage" class="btn btn--dark">
        Projekt unverbindlich anfragen
        <span class="btn__icon"><Icon name="arrow-up-right" size={16} /></span>
      </a>

      {
        site.contact.phone && (
          <a href={telHref(site.contact.phone)} class="text-link">
            <Icon name="phone" size={16} />
            {site.contact.phone}
          </a>
        )
      }

      <a href={site.instagram.url} target="_blank" rel="noopener noreferrer" class="text-link">
        <Icon name="instagram" size={16} />
        Instagram
        <span class="sr-only">(öffnet in neuem Tab)</span>
      </a>
    </div>
  </div>
</section>

<style>
  .contact {
    position: relative;
    overflow: hidden;
    background: var(--color-sand);
    color: var(--color-ink);
  }

  .contact::before,
  .contact::after {
    content: "";
    position: absolute;
    border: 1px solid rgb(32 32 30 / 0.12);
    border-radius: 50%;
    pointer-events: none;
  }

  .contact::before {
    top: -360px;
    right: -260px;
    width: 700px;
    height: 700px;
  }

  .contact::after {
    top: -230px;
    right: -130px;
    width: 440px;
    height: 440px;
  }

  .contact-inner {
    position: relative;
    z-index: 1;
  }

  .contact .eyebrow {
    color: var(--color-ink);
  }

  .contact h2 em {
    color: #5e4d3c; /* 4.6:1 auf sand */
  }

  .contact-lead {
    max-width: 32em;
    margin-top: clamp(32px, 4vw, 52px);
    color: rgb(20 20 19 / 0.8);
    font-size: var(--fs-lead);
    line-height: 1.75;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px 36px;
    margin-top: clamp(36px, 4vw, 52px);
  }

  .contact .text-link {
    border-color: rgb(20 20 19 / 0.35);
  }

  @media (max-width: 599.98px) {
    .contact-actions {
      flex-direction: column;
      align-items: flex-start;
    }

    .contact-actions .btn {
      width: 100%;
    }
  }
</style>

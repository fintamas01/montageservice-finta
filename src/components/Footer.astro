---
import Icon from "./ui/Icon.astro";
import { navigation, services, site, telHref } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="footer surface-dark on-dark">
  <div class="container footer-main">
    <div class="footer-brand">
      <a href="/" class="footer-logo" aria-label={`${site.name} – zur Startseite`}>
        <span class="brand-small" aria-hidden="true">Montageservice</span>
        <span class="brand-name" aria-hidden="true">Finta</span>
      </a>
      <p>
        Küchenmontage, Möbelmontage sowie Montage von Türen und Zargen –
        präzise und sauber ausgeführt.
      </p>
      <a href="/anfrage" class="btn btn--sand footer-cta">
        Montage anfragen
        <span class="btn__icon"><Icon name="arrow-up-right" size={16} /></span>
      </a>
    </div>

    <nav class="footer-column" aria-labelledby="footer-nav-title">
      <h2 class="footer-title" id="footer-nav-title">Navigation</h2>
      <ul>
        {navigation.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><a href="/anfrage">Anfrage</a></li>
      </ul>
    </nav>

    <div class="footer-column">
      <h2 class="footer-title">Leistungen</h2>
      <ul>
        {
          services.map((service) => (
            <li>
              <a href={`/anfrage?leistung=${service.slug}`}>{service.title}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="footer-column">
      <h2 class="footer-title">Kontakt</h2>
      <ul>
        {
          site.contact.phone && (
            <li>
              <a href={telHref(site.contact.phone)} class="icon-link">
                <Icon name="phone" size={16} />
                {site.contact.phone}
              </a>
            </li>
          )
        }
        {
          site.contact.email && (
            <li>
              <a href={`mailto:${site.contact.email}`} class="icon-link">
                <Icon name="mail" size={16} />
                {site.contact.email}
              </a>
            </li>
          )
        }
        <li>
          <a href="/anfrage" class="icon-link">
            <Icon name="mail" size={16} />
            Anfrageformular
          </a>
        </li>
        <li>
          <a href={site.instagram.url} target="_blank" rel="noopener noreferrer" class="icon-link">
            <Icon name="instagram" size={16} />
            {site.instagram.handle}
            <span class="sr-only">(Instagram, öffnet in neuem Tab)</span>
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>© {year} {site.name}</p>
    <ul class="legal-links">
      <li><a href="/impressum">Impressum</a></li>
      <li><a href="/datenschutz">Datenschutz</a></li>
    </ul>
  </div>
</footer>

<style>
  .footer {
    padding-top: clamp(72px, 8vw, 112px);
    padding-bottom: max(28px, env(safe-area-inset-bottom));
  }

  .footer-main {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr));
    gap: 48px;
    padding-bottom: clamp(56px, 7vw, 96px);
  }

  .footer-logo {
    display: inline-flex;
    flex-direction: column;
    line-height: 1;
  }

  .brand-small {
    color: var(--color-sand);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.26em;
    text-transform: uppercase;
  }

  .brand-name {
    margin-top: 6px;
    font-family: var(--font-display);
    font-size: 3rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .footer-brand p {
    max-width: 30ch;
    margin-top: 24px;
    color: var(--color-on-dark-muted);
    font-size: var(--fs-small);
  }

  .footer-cta {
    margin-top: 32px;
  }

  .footer-title {
    margin-bottom: 18px;
    color: var(--color-sand);
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .footer-column ul {
    display: grid;
    gap: 4px;
    list-style: none;
  }

  .footer-column a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    color: var(--color-on-dark-muted);
    font-size: 0.9375rem;
    transition: color var(--duration) ease;
  }

  .footer-column a:hover {
    color: var(--color-white);
  }

  .icon-link {
    gap: 10px;
    overflow-wrap: anywhere;
  }

  .icon-link :global(.icon) {
    flex: none;
    color: var(--color-sand);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 32px;
    padding-top: 24px;
    border-top: 1px solid var(--color-on-dark-line);
    color: var(--color-on-dark-subtle);
    font-size: var(--fs-small);
  }

  .legal-links {
    display: flex;
    gap: 28px;
    list-style: none;
  }

  .legal-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-on-dark-muted);
  }

  .legal-links a:hover {
    color: var(--color-white);
  }

  @media (max-width: 960px) {
    .footer-main {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 640px) {
    .footer-main {
      grid-template-columns: 1fr 1fr;
      gap: 40px 24px;
    }

    .footer-column:last-child {
      grid-column: 1 / -1;
    }
  }
</style>

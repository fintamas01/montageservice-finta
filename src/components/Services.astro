---
import { Picture } from "astro:assets";
import Icon from "./ui/Icon.astro";
import { services } from "../data/site";
---

<section class="section surface-sand" id="leistungen" aria-labelledby="leistungen-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow">Leistungen</p>
        <h2 class="display-l" id="leistungen-title">
          Präzise Arbeit.<br />
          <em>Bis ins Detail.</em>
        </h2>
      </div>
      <p class="lead">
        Von der Küche bis zur Innentür: Wir übernehmen Ihre Montage
        zuverlässig, sauber und mit hohem Anspruch an das Ergebnis.
      </p>
    </div>

    <ul class="service-list">
      {
        services.map((service, index) => (
          <li class="service-card" data-reveal data-reveal-delay={index + 1}>
            <Picture
              src={service.image}
              alt={service.alt}
              formats={["avif", "webp"]}
              widths={[400, 640, 900]}
              sizes="(min-width: 1024px) 30vw, (min-width: 700px) 50vw, 100vw"
              class="service-image"
            />

            <div class="service-body">
              <span class="service-index" aria-hidden="true">
                {String(index + 1).padStart(2, "0")} — {service.short}
              </span>

              <h3 class="display-m">
                <a href={`/anfrage?leistung=${service.slug}`} class="service-link">
                  {service.title}
                </a>
              </h3>

              <p>{service.description}</p>

              <span class="service-cta" aria-hidden="true">
                Jetzt anfragen
                <Icon name="arrow-up-right" size={16} />
              </span>
            </div>
          </li>
        ))
      }
    </ul>

    <p class="service-note" data-reveal>
      Ihr Vorhaben ist nicht dabei?
      <a href="/anfrage?leistung=sonstiges" class="text-link">
        Beschreiben Sie es uns
        <Icon name="arrow-right" size={16} />
      </a>
    </p>
  </div>
</section>

<style>
  .service-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    list-style: none;
  }

  .service-card {
    position: relative;
    isolation: isolate;
    min-height: clamp(500px, 48vw, 640px);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    border-radius: var(--radius);
    background: #37332f;
    color: var(--color-white);
    box-shadow: var(--shadow-soft);
  }

  .service-card :global(.service-image) {
    position: absolute;
    z-index: -2;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--ease-out);
  }

  .service-card::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;
    background: linear-gradient(180deg, rgb(15 15 14 / 0.05) 25%, rgb(15 15 14 / 0.55) 55%, rgb(15 15 14 / 0.9) 100%);
  }

  .service-card:hover :global(.service-image) {
    transform: scale(1.05);
  }

  .service-body {
    padding: clamp(22px, 2.4vw, 32px);
  }

  .service-index {
    display: block;
    margin-bottom: 14px;
    color: var(--color-sand);
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .service-body h3 {
    margin-bottom: 14px;
  }

  .service-link::after {
    /* gesamte Karte klickbar, Link-Text bleibt der zugängliche Name */
    content: "";
    position: absolute;
    inset: 0;
  }

  .service-link:focus-visible {
    outline: none;
  }

  .service-card:has(.service-link:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  .service-body p {
    max-width: 34ch;
    color: rgb(255 255 255 / 0.82);
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  .service-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 22px;
    padding-bottom: 6px;
    border-bottom: 1px solid rgb(255 255 255 / 0.35);
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition:
      border-color var(--duration) ease,
      gap var(--duration) var(--ease-out);
  }

  .service-card:hover .service-cta {
    gap: 16px;
    border-color: var(--color-sand);
  }

  .service-note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 20px;
    margin-top: 40px;
    color: var(--color-text-muted);
  }

  .service-note .text-link {
    color: var(--color-text);
  }

  @media (max-width: 1023.98px) {
    .service-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .service-card:last-child {
      grid-column: 1 / -1;
      min-height: 460px;
    }
  }

  @media (max-width: 699.98px) {
    .service-list {
      grid-template-columns: 1fr;
    }

    .service-card,
    .service-card:last-child {
      min-height: 440px;
    }
  }
</style>

---
const steps = [
  {
    title: "Anfrage",
    text: "Sie schicken uns die wichtigsten Eckdaten zu Ihrem Projekt – gerne direkt mit Fotos.",
  },
  {
    title: "Abstimmung",
    text: "Wir besprechen Umfang, Termin und alle relevanten Details persönlich mit Ihnen.",
  },
  {
    title: "Montage",
    text: "Wir führen die Arbeiten vor Ort fachgerecht, präzise und sauber aus.",
  },
  {
    title: "Übergabe",
    text: "Zum Abschluss prüfen wir das Ergebnis gemeinsam mit Ihnen und übergeben die fertige Montage.",
  },
];
---

<section class="section surface-sand" id="ablauf" aria-labelledby="ablauf-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow">Ablauf</p>
        <h2 class="display-l" id="ablauf-title">
          Klarer Ablauf.<br />
          <em>Sauberes Ergebnis.</em>
        </h2>
      </div>
      <p class="lead">
        Von der ersten Anfrage bis zur fertigen Montage behalten Sie den
        Überblick – persönlich, unkompliziert und verlässlich.
      </p>
    </div>

    <ol class="steps">
      {
        steps.map((step, index) => (
          <li class="step" data-reveal data-reveal-delay={index + 1}>
            <span class="step-number" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
            <h3 class="display-s">{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    list-style: none;
    border-top: 1px solid var(--color-line-strong);
  }

  .step {
    position: relative;
    padding: 40px 32px 8px 0;
  }

  .step + .step {
    padding-left: 32px;
    border-left: 1px solid var(--color-line);
  }

  .step::before {
    content: "";
    position: absolute;
    top: -4.5px;
    left: 0;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .step + .step::before {
    left: 32px;
  }

  .step-number {
    display: block;
    margin-bottom: 48px;
    color: var(--color-accent);
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
  }

  .step h3 {
    margin-bottom: 14px;
  }

  .step p {
    max-width: 30ch;
    color: var(--color-text-muted);
    font-size: 0.9375rem;
  }

  @media (max-width: 959.98px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 32px;
    }

    .step:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }

    .step:nth-child(3)::before {
      left: 0;
    }

    .step:nth-child(n + 3) {
      border-top: 1px solid var(--color-line-strong);
    }
  }

  @media (max-width: 599.98px) {
    .steps {
      grid-template-columns: 1fr;
      row-gap: 0;
      border-top: 0;
    }

    .step,
    .step + .step,
    .step:nth-child(n + 3) {
      display: grid;
      grid-template-columns: 48px 1fr;
      column-gap: 8px;
      padding: 28px 0;
      border-left: 0;
      border-top: 1px solid var(--color-line-strong);
    }

    .step::before,
    .step + .step::before {
      display: none;
    }

    .step-number {
      grid-row: span 2;
      margin: 10px 0 0;
    }
  }
</style>

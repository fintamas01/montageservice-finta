---
import Icon from "./ui/Icon.astro";
import { otherServiceValue, services } from "../data/site";
import { uploadLimits } from "../data/form";

const serviceOptions = [
  ...services.map((s) => ({ slug: s.slug, value: s.formValue, label: s.title })),
  { slug: "sonstiges", value: otherServiceValue, label: "Sonstiges" },
];

const maxFileMb = uploadLimits.maxFileSize / 1024 / 1024;
---

<form
  class="request-form"
  id="request-form"
  action="/api/send-request.php"
  method="post"
  enctype="multipart/form-data"
  novalidate
>
  <div class="form-status" id="form-status" role="alert" tabindex="-1" hidden>
    <Icon name="alert" size={20} />
    <p data-status-text></p>
  </div>

  <!-- Spam-Schutz: Honeypot (für Menschen unsichtbar) + Zeitstempel -->
  <div class="hp-field" aria-hidden="true">
    <label for="website">Website (bitte leer lassen)</label>
    <input id="website" type="text" name="website" tabindex="-1" autocomplete="off" />
  </div>
  <input type="hidden" name="form_ts" id="form_ts" value="" />

  <!-- 01 Leistung -->
  <fieldset class="form-block" aria-describedby="service-error">
    <legend class="block-heading">
      <span class="block-number" aria-hidden="true">01</span>
      <span class="block-title">Um welche Leistung geht es? <span class="req" aria-hidden="true">*</span></span>
    </legend>

    <div class="service-options" data-field="service">
      {
        serviceOptions.map((option, index) => (
          <label class="service-option">
            <input
              type="radio"
              name="service"
              value={option.value}
              data-slug={option.slug}
              required={index === 0}
            />
            <span class="option-content">
              <span class="option-label">{option.label}</span>
              <span class="option-check" aria-hidden="true">
                <Icon name="check" size={14} />
              </span>
            </span>
          </label>
        ))
      }
    </div>
    <p class="field-error" id="service-error" data-error-for="service"></p>
  </fieldset>

  <!-- 02 Montageort -->
  <fieldset class="form-block">
    <legend class="block-heading">
      <span class="block-number" aria-hidden="true">02</span>
      <span class="block-title">Wo soll montiert werden?</span>
    </legend>

    <div class="field-grid field-grid--plz">
      <div class="field">
        <label for="postal_code">PLZ <span class="req" aria-hidden="true">*</span></label>
        <input
          id="postal_code"
          type="text"
          name="postal_code"
          inputmode="numeric"
          autocomplete="postal-code"
          pattern="[0-9]{4,5}"
          maxlength="5"
          required
          aria-describedby="postal_code-error"
        />
        <p class="field-error" id="postal_code-error" data-error-for="postal_code"></p>
      </div>

      <div class="field">
        <label for="city">Ort <span class="req" aria-hidden="true">*</span></label>
        <input
          id="city"
          type="text"
          name="city"
          autocomplete="address-level2"
          maxlength="150"
          required
          aria-describedby="city-error"
        />
        <p class="field-error" id="city-error" data-error-for="city"></p>
      </div>
    </div>
  </fieldset>

  <!-- 03 Projekt -->
  <fieldset class="form-block">
    <legend class="block-heading">
      <span class="block-number" aria-hidden="true">03</span>
      <span class="block-title">Was dürfen wir für Sie montieren?</span>
    </legend>

    <div class="field">
      <label for="message">Projektbeschreibung <span class="req" aria-hidden="true">*</span></label>
      <p class="field-hint" id="message-hint">
        Zum Beispiel: Art und Umfang der Montage, Maße, gewünschter Zeitraum,
        Etage bzw. Zugang.
      </p>
      <textarea
        id="message"
        name="message"
        rows="7"
        maxlength="5000"
        minlength="10"
        required
        aria-describedby="message-hint message-error"
      ></textarea>
      <p class="field-error" id="message-error" data-error-for="message"></p>
    </div>
  </fieldset>

  <!-- 04 Fotos -->
  <fieldset class="form-block">
    <legend class="block-heading">
      <span class="block-number" aria-hidden="true">04</span>
      <span class="block-title">Fotos <span class="optional">(optional)</span></span>
    </legend>

    <div class="field">
      <label class="upload-box" id="upload-box" for="photos">
        <span class="upload-icon" aria-hidden="true"><Icon name="image" size={22} /></span>
        <strong>Fotos auswählen</strong>
        <span class="upload-help" id="photos-hint">
          Bis zu {uploadLimits.maxFiles} Fotos · JPG, PNG oder WebP · max.
          {maxFileMb} MB pro Foto
        </span>
      </label>
      <input
        id="photos"
        class="upload-input"
        type="file"
        name="photos[]"
        accept={uploadLimits.acceptedTypes.join(",")}
        multiple
        aria-describedby="photos-hint photos-error"
      />
      <p class="field-error" id="photos-error" data-error-for="photos"></p>

      <div class="file-summary" id="file-summary" hidden>
        <ul class="file-list" id="file-list" aria-live="polite"></ul>
        <button type="button" class="file-reset" id="file-reset">
          <Icon name="close" size={14} />
          Auswahl entfernen
        </button>
      </div>
    </div>
  </fieldset>

  <!-- 05 Kontakt -->
  <fieldset class="form-block">
    <legend class="block-heading">
      <span class="block-number" aria-hidden="true">05</span>
      <span class="block-title">Wie erreichen wir Sie?</span>
    </legend>

    <div class="field-grid">
      <div class="field">
        <label for="name">Vor- und Nachname <span class="req" aria-hidden="true">*</span></label>
        <input id="name" type="text" name="name" autocomplete="name" maxlength="150" required aria-describedby="name-error" />
        <p class="field-error" id="name-error" data-error-for="name"></p>
      </div>

      <div class="field">
        <label for="phone">Telefon <span class="req" aria-hidden="true">*</span></label>
        <input
          id="phone"
          type="tel"
          name="phone"
          autocomplete="tel"
          maxlength="30"
          pattern="[0-9+()/ \-]{6,30}"
          required
          aria-describedby="phone-error"
        />
        <p class="field-error" id="phone-error" data-error-for="phone"></p>
      </div>

      <div class="field">
        <label for="email">E-Mail <span class="req" aria-hidden="true">*</span></label>
        <input id="email" type="email" name="email" autocomplete="email" maxlength="254" required aria-describedby="email-error" />
        <p class="field-error" id="email-error" data-error-for="email"></p>
      </div>

      <div class="field">
        <label for="preferred_contact">Bevorzugter Kontaktweg</label>
        <div class="select-wrap">
          <select id="preferred_contact" name="preferred_contact">
            <option value="Telefon">Telefon</option>
            <option value="WhatsApp">WhatsApp</option>
            <option value="E-Mail">E-Mail</option>
          </select>
        </div>
      </div>
    </div>
  </fieldset>

  <!-- Datenschutz + Absenden -->
  <div class="submit-area">
    <div class="privacy">
      <input
        id="privacy"
        type="checkbox"
        name="privacy"
        value="accepted"
        required
        aria-describedby="privacy-error"
      />
      <label for="privacy">
        Ich habe die <a href="/datenschutz" target="_blank">Datenschutzerklärung<span class="sr-only"> (öffnet in neuem Tab)</span></a>
        gelesen und bin einverstanden, dass meine Angaben zur Bearbeitung
        meiner Anfrage verwendet werden. <span class="req" aria-hidden="true">*</span>
      </label>
      <p class="field-error" id="privacy-error" data-error-for="privacy"></p>
    </div>

    <p class="required-note"><span aria-hidden="true">*</span> Pflichtfeld</p>

    <button type="submit" class="btn btn--dark submit-button" id="submit-button">
      <span data-submit-label>Anfrage absenden</span>
      <span class="btn__icon"><Icon name="arrow-up-right" size={16} /></span>
    </button>
  </div>
</form>

<script>
  import { statusMessages, uploadLimits } from "../data/form";

  const form = document.querySelector<HTMLFormElement>("#request-form");

  if (form) {
    const statusBox = form.querySelector<HTMLElement>("#form-status")!;
    const statusText = statusBox.querySelector<HTMLElement>("[data-status-text]")!;
    const submitButton = form.querySelector<HTMLButtonElement>("#submit-button")!;
    const submitLabel = submitButton.querySelector<HTMLElement>("[data-submit-label]")!;
    const fileInput = form.querySelector<HTMLInputElement>("#photos")!;
    const uploadBox = form.querySelector<HTMLLabelElement>("#upload-box")!;
    const fileSummary = form.querySelector<HTMLElement>("#file-summary")!;
    const fileList = form.querySelector<HTMLUListElement>("#file-list")!;
    const fileReset = form.querySelector<HTMLButtonElement>("#file-reset")!;
    const timestamp = form.querySelector<HTMLInputElement>("#form_ts")!;

    timestamp.value = String(Math.floor(Date.now() / 1000));

    let attempted = false;

    /* ---------- Statusmeldungen ---------- */

    const showStatus = (message: string) => {
      statusText.textContent = message;
      statusBox.hidden = false;
      statusBox.focus();
    };

    const hideStatus = () => {
      statusBox.hidden = true;
    };

    // Fallback ohne JavaScript-Versand: Server leitet mit ?status=… zurück
    const params = new URLSearchParams(window.location.search);
    const initialStatus = params.get("status");
    if (initialStatus) {
      showStatus(statusMessages[initialStatus] ?? statusMessages.send);
    }

    // Leistung aus Link vorauswählen (?leistung=kuechenmontage)
    const preselect = params.get("leistung");
    if (preselect) {
      const radio = form.querySelector<HTMLInputElement>(
        `input[name="service"][data-slug="${CSS.escape(preselect)}"]`,
      );
      if (radio) radio.checked = true;
    }

    /* ---------- Validierung ---------- */

    const formatSize = (bytes: number) =>
      bytes < 1024 * 1024
        ? `${Math.max(1, Math.round(bytes / 1024))} KB`
        : `${(bytes / 1024 / 1024).toFixed(1).replace(".", ",")} MB`;

    const validateFiles = (): string => {
      const files = Array.from(fileInput.files ?? []);
      if (files.length > uploadLimits.maxFiles) return statusMessages.files;
      let total = 0;
      for (const file of files) {
        if (!(uploadLimits.acceptedTypes as readonly string[]).includes(file.type)) {
          return statusMessages.filetype;
        }
        if (file.size > uploadLimits.maxFileSize) return statusMessages.filesize;
        total += file.size;
      }
      if (total > uploadLimits.maxTotalSize) return statusMessages.filesize;
      return "";
    };

    const validators: Record<string, () => string> = {
      service: () =>
        form.querySelector('input[name="service"]:checked') ? "" : "Bitte wählen Sie eine Leistung aus.",
      postal_code: () => {
        const v = (form.elements.namedItem("postal_code") as HTMLInputElement).value.trim();
        if (!v) return "Bitte geben Sie die Postleitzahl an.";
        return /^[0-9]{4,5}$/.test(v) ? "" : "Bitte geben Sie eine gültige Postleitzahl an (4–5 Ziffern).";
      },
      city: () =>
        (form.elements.namedItem("city") as HTMLInputElement).value.trim() ? "" : "Bitte geben Sie den Ort an.",
      message: () => {
        const v = (form.elements.namedItem("message") as HTMLTextAreaElement).value.trim();
        if (!v) return "Bitte beschreiben Sie kurz Ihr Projekt.";
        return v.length >= 10 ? "" : "Bitte beschreiben Sie Ihr Projekt etwas ausführlicher.";
      },
      photos: validateFiles,
      name: () =>
        (form.elements.namedItem("name") as HTMLInputElement).value.trim() ? "" : "Bitte geben Sie Ihren Namen an.",
      phone: () => {
        const v = (form.elements.namedItem("phone") as HTMLInputElement).value.trim();
        if (!v) return "Bitte geben Sie eine Telefonnummer an.";
        return /^[0-9+()/ \-]{6,30}$/.test(v) ? "" : "Bitte geben Sie eine gültige Telefonnummer an.";
      },
      email: () => {
        const input = form.elements.namedItem("email") as HTMLInputElement;
        const v = input.value.trim();
        if (!v) return "Bitte geben Sie Ihre E-Mail-Adresse an.";
        return input.validity.typeMismatch || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)
          ? "Bitte geben Sie eine gültige E-Mail-Adresse an."
          : "";
      },
      privacy: () =>
        (form.elements.namedItem("privacy") as HTMLInputElement).checked
          ? ""
          : "Bitte bestätigen Sie die Datenschutzhinweise.",
    };

    const setFieldError = (name: string, message: string) => {
      const errorEl = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
      if (errorEl) errorEl.textContent = message;

      const targets =
        name === "service"
          ? form.querySelectorAll<HTMLInputElement>('input[name="service"]')
          : form.querySelectorAll<HTMLElement>(`#${name}`);

      targets.forEach((el) => {
        if (message) el.setAttribute("aria-invalid", "true");
        else el.removeAttribute("aria-invalid");
      });
    };

    const validateField = (name: string) => {
      const message = validators[name]?.() ?? "";
      setFieldError(name, message);
      return message;
    };

    const validateAll = () => {
      let firstInvalid: string | null = null;
      for (const name of Object.keys(validators)) {
        if (validateField(name) && !firstInvalid) firstInvalid = name;
      }
      return firstInvalid;
    };

    const focusField = (name: string) => {
      const el =
        name === "service"
          ? form.querySelector<HTMLInputElement>('input[name="service"]')
          : form.querySelector<HTMLElement>(`#${name}`);
      el?.focus();
    };

    form.addEventListener("input", (event) => {
      const target = event.target as HTMLInputElement;
      if (attempted && validators[target.name.replace("[]", "")]) {
        validateField(target.name === "photos[]" ? "photos" : target.name);
      }
    });

    form.addEventListener(
      "blur",
      (event) => {
        const target = event.target as HTMLInputElement;
        if (attempted && target.name && validators[target.name]) validateField(target.name);
      },
      true,
    );

    /* ---------- Datei-Upload ---------- */

    const renderFiles = () => {
      const files = Array.from(fileInput.files ?? []);
      fileList.replaceChildren(
        ...files.map((file, index) => {
          const li = document.createElement("li");
          const num = document.createElement("span");
          const name = document.createElement("strong");
          const size = document.createElement("small");
          num.textContent = String(index + 1).padStart(2, "0");
          name.textContent = file.name; // textContent: kein HTML-Injection-Risiko
          size.textContent = formatSize(file.size);
          li.append(num, name, size);
          return li;
        }),
      );
      fileSummary.hidden = files.length === 0;
      validateField("photos");
    };

    fileInput.addEventListener("change", renderFiles);

    fileReset.addEventListener("click", () => {
      fileInput.value = "";
      renderFiles();
      fileInput.focus();
    });

    ["dragenter", "dragover"].forEach((type) =>
      uploadBox.addEventListener(type, (event) => {
        event.preventDefault();
        uploadBox.classList.add("is-dragging");
      }),
    );

    ["dragleave", "dragend"].forEach((type) =>
      uploadBox.addEventListener(type, () => uploadBox.classList.remove("is-dragging")),
    );

    uploadBox.addEventListener("drop", (event) => {
      event.preventDefault();
      uploadBox.classList.remove("is-dragging");
      if (event.dataTransfer?.files.length) {
        fileInput.files = event.dataTransfer.files;
        renderFiles();
      }
    });

    /* ---------- Absenden ---------- */

    const setLoading = (loading: boolean) => {
      submitButton.disabled = loading;
      submitButton.setAttribute("aria-busy", String(loading));
      submitLabel.textContent = loading ? "Wird gesendet …" : "Anfrage absenden";
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      attempted = true;
      hideStatus();

      const firstInvalid = validateAll();
      if (firstInvalid) {
        focusField(firstInvalid);
        return;
      }

      setLoading(true);

      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });

        const result = (await response.json().catch(() => null)) as {
          ok?: boolean;
          code?: string;
          field?: string;
          redirect?: string;
        } | null;

        if (response.ok && result?.ok) {
          window.location.assign(result.redirect ?? "/danke");
          return;
        }

        const code = result?.code ?? "send";
        const message = statusMessages[code] ?? statusMessages.send;
        if (result?.field && validators[result.field]) {
          setFieldError(result.field, message);
        }
        showStatus(message);
      } catch {
        showStatus(statusMessages.network);
      } finally {
        setLoading(false);
      }
    });
  }
</script>

<style>
  .request-form {
    min-width: 0;
  }

  .form-status {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    margin-bottom: 32px;
    padding: 18px 20px;
    border-left: 3px solid var(--color-error);
    background: var(--color-error-bg);
    color: var(--color-error);
    font-weight: 500;
  }

  .form-status[hidden] {
    display: none;
  }

  .form-status :global(.icon) {
    flex: none;
    margin-top: 2px;
  }

  .form-status:focus {
    outline: none;
  }

  .form-block {
    min-width: 0;
    margin: 0;
    padding: clamp(40px, 5vw, 64px) 0;
    border: 0;
    border-top: 1px solid var(--color-line);
  }

  .form-block:first-of-type {
    padding-top: 0;
    border-top: 0;
  }

  .block-heading {
    display: flex;
    align-items: baseline;
    gap: 18px;
    width: 100%;
    margin-bottom: 28px;
    padding: 0;
  }

  .block-number {
    flex: none;
    color: var(--color-accent);
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
  }

  .block-title {
    font-family: var(--font-display);
    font-size: var(--fs-display-s);
    line-height: 1.15;
  }

  .optional {
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-size: var(--fs-small);
  }

  .req {
    color: var(--color-accent);
  }

  /* Leistung */

  .service-options {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .service-option {
    position: relative;
    cursor: pointer;
  }

  .service-option input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }

  .option-content {
    min-height: 68px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 18px 12px 22px;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius);
    background: var(--color-white);
    transition:
      background-color var(--duration) ease,
      border-color var(--duration) ease,
      color var(--duration) ease;
  }

  .option-label {
    font-weight: 600;
  }

  .option-check {
    display: grid;
    place-items: center;
    flex: none;
    width: 26px;
    height: 26px;
    border: 1px solid var(--color-line-strong);
    border-radius: 50%;
    color: transparent;
    transition:
      background-color var(--duration) ease,
      border-color var(--duration) ease,
      color var(--duration) ease;
  }

  .service-option:hover .option-content {
    border-color: var(--color-accent);
  }

  .service-option input:focus-visible + .option-content {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .service-option input:checked + .option-content {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: var(--color-white);
  }

  .service-option input:checked + .option-content .option-check {
    border-color: var(--color-sand);
    background: var(--color-sand);
    color: var(--color-ink);
  }

  .service-option input[aria-invalid="true"] + .option-content {
    border-color: var(--color-error);
  }

  /* Felder */

  .field-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px 32px;
  }

  .field-grid--plz {
    grid-template-columns: minmax(0, 0.6fr) minmax(0, 1.4fr);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .field > label:not(.upload-box) {
    font-size: var(--fs-small);
    font-weight: 600;
  }

  .field-hint {
    color: var(--color-text-muted);
    font-size: var(--fs-small);
  }

  .field input,
  .field textarea,
  .field select {
    width: 100%;
    min-height: 52px;
    padding: 12px 16px;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius);
    background: var(--color-white);
    color: var(--color-ink);
    font: inherit;
    font-size: 1rem;
    transition:
      border-color var(--duration) ease,
      box-shadow var(--duration) ease;
  }

  .field textarea {
    min-height: 180px;
    resize: vertical;
    line-height: 1.6;
  }

  .field input:hover,
  .field textarea:hover,
  .field select:hover {
    border-color: var(--color-accent);
  }

  .field input:focus,
  .field textarea:focus,
  .field select:focus {
    border-color: var(--color-ink);
    outline: none;
    box-shadow: 0 0 0 3px rgb(107 89 71 / 0.25);
  }

  .field [aria-invalid="true"] {
    border-color: var(--color-error);
  }

  .select-wrap {
    position: relative;
  }

  .select-wrap::after {
    content: "";
    position: absolute;
    top: 50%;
    right: 18px;
    width: 8px;
    height: 8px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-70%) rotate(45deg);
    pointer-events: none;
  }

  .field select {
    appearance: none;
    padding-right: 44px;
  }

  .field-error {
    color: var(--color-error);
    font-size: var(--fs-small);
    font-weight: 500;
  }

  .field-error:empty {
    display: none;
  }

  /* Upload */

  .upload-input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .upload-box {
    min-height: 190px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 28px 20px;
    border: 1px dashed var(--color-line-strong);
    border-radius: var(--radius);
    background: var(--color-white);
    text-align: center;
    cursor: pointer;
    transition:
      background-color var(--duration) ease,
      border-color var(--duration) ease;
  }

  .upload-box:hover,
  .upload-box.is-dragging {
    border-color: var(--color-accent);
    background: #fbf9f6;
  }

  .field:has(.upload-input:focus-visible) .upload-box {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .upload-icon {
    display: grid;

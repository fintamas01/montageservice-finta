<section class="request-hero">
  <div class="request-hero-inner">

    <p>
      Projektanfrage
    </p>

    <span>
      Unverbindlich · Persönlich · Einfach
    </span>

  </div>
</section>

<section class="request-section">
  <div class="request-wrapper">

    <div class="request-intro">
      <div class="section-index">
        <span>01</span>
        <span class="line"></span>
        <span>Projektanfrage</span>
      </div>

      <p class="eyebrow">Ihr Projekt</p>

      <h1>
        Erzählen Sie uns<br />
        <em>von Ihrem Vorhaben.</em>
      </h1>

      <p class="intro-text">
        Je mehr Informationen Sie uns senden, desto besser können wir
        Ihr Projekt einschätzen. Fotos können Sie direkt mitsenden.
      </p>
    </div>


    <form
      class="request-form"
      action="/api/send-request.php"
      method="POST"
      enctype="multipart/form-data"
      id="request-form"
    >

      <!-- Honeypot -->
      <div class="hp-field" aria-hidden="true">
        <label>
          Website
          <input
            type="text"
            name="website"
            tabindex="-1"
            autocomplete="off"
          />
        </label>
      </div>


      <!-- STEP 01 -->
      <fieldset class="form-block" data-reveal>
        <div class="block-heading">
          <span class="block-number">01</span>

          <div>
            <p class="block-label">Leistung</p>
            <h2>Worum geht es?</h2>
          </div>
        </div>

        <div class="service-options">

          <label class="service-option">
            <input
              type="radio"
              name="service"
              value="Küchenmontage"
              required
            />

            <span class="option-content">
              <span class="option-number">01</span>

              <strong>Küchenmontage</strong>

              <span class="check">✓</span>
            </span>
          </label>


          <label class="service-option">
            <input
              type="radio"
              name="service"
              value="Möbelmontage"
            />

            <span class="option-content">
              <span class="option-number">02</span>

              <strong>Möbelmontage</strong>

              <span class="check">✓</span>
            </span>
          </label>


          <label class="service-option">
            <input
              type="radio"
              name="service"
              value="Türen und Zargen"
            />

            <span class="option-content">
              <span class="option-number">03</span>

              <strong>Türen & Zargen</strong>

              <span class="check">✓</span>
            </span>
          </label>


          <label class="service-option">
            <input
              type="radio"
              name="service"
              value="Sonstiges"
            />

            <span class="option-content">
              <span class="option-number">04</span>

              <strong>Sonstiges</strong>

              <span class="check">✓</span>
            </span>
          </label>

        </div>
      </fieldset>


      <!-- STEP 02 -->
      <fieldset class="form-block" data-reveal>
        <div class="block-heading">
          <span class="block-number">02</span>

          <div>
            <p class="block-label">Montageort</p>
            <h2>Wo findet die Montage statt?</h2>
          </div>
        </div>

        <div class="field-grid two-columns">
          <label class="field">
            <span>PLZ *</span>

            <input
              type="text"
              name="postal_code"
              placeholder="z. B. 89597"
              required
              autocomplete="postal-code"
            />
          </label>

          <label class="field">
            <span>Ort *</span>

            <input
              type="text"
              name="city"
              placeholder="Ort"
              required
              autocomplete="address-level2"
            />
          </label>
        </div>
      </fieldset>


      <!-- STEP 03 -->
      <fieldset class="form-block" data-reveal>
        <div class="block-heading">
          <span class="block-number">03</span>

          <div>
            <p class="block-label">Projekt</p>
            <h2>Was können wir für Sie tun?</h2>
          </div>
        </div>

        <label class="field textarea-field">
          <span>Projektbeschreibung *</span>

          <textarea
            name="message"
            rows="7"
            required
            placeholder="Beschreiben Sie kurz Ihr Projekt, den gewünschten Umfang und besondere Anforderungen..."
          ></textarea>
        </label>
      </fieldset>


      <!-- STEP 04 -->
      <fieldset class="form-block" data-reveal>
        <div class="block-heading">
          <span class="block-number">04</span>

          <div>
            <p class="block-label">Fotos</p>
            <h2>Bilder helfen bei der Einschätzung.</h2>
          </div>
        </div>

        <label class="upload-box" id="upload-box">
          <input
            id="photos"
            type="file"
            name="photos[]"
            accept="image/jpeg,image/png,image/webp"
            multiple
          />

          <span class="upload-icon">+</span>

          <strong>Fotos auswählen</strong>

          <span class="upload-help">
            JPG, PNG oder WebP · mehrere Bilder möglich
          </span>
        </label>

        <div
          class="file-list"
          id="file-list"
          aria-live="polite"
        ></div>
      </fieldset>


      <!-- STEP 05 -->
      <fieldset class="form-block" data-reveal>
        <div class="block-heading">
          <span class="block-number">05</span>

          <div>
            <p class="block-label">Kontakt</p>
            <h2>Wie können wir Sie erreichen?</h2>
          </div>
        </div>

        <div class="field-grid two-columns">

          <label class="field">
            <span>Name *</span>

            <input
              type="text"
              name="name"
              required
              autocomplete="name"
              placeholder="Vor- und Nachname"
            />
          </label>


          <label class="field">
            <span>Telefon *</span>

            <input
              type="tel"
              name="phone"
              required
              autocomplete="tel"
              placeholder="+49 ..."
            />
          </label>


          <label class="field">
            <span>E-Mail *</span>

            <input
              type="email"
              name="email"
              required
              autocomplete="email"
              placeholder="name@email.de"
            />
          </label>


          <label class="field">
            <span>Bevorzugter Kontakt</span>

            <select name="preferred_contact">
              <option value="Telefon">
                Telefon
              </option>

              <option value="WhatsApp">
                WhatsApp
              </option>

              <option value="E-Mail">
                E-Mail
              </option>
            </select>
          </label>

        </div>
      </fieldset>


      <!-- PRIVACY + SUBMIT -->
      <div class="submit-area" data-reveal>

        <label class="privacy">
          <input
            type="checkbox"
            name="privacy"
            value="accepted"
            required
          />

          <span class="custom-checkbox"></span>

          <span>
            Ich habe die
            <a href="/datenschutz">
              Datenschutzerklärung
            </a>
            gelesen und stimme der Verarbeitung meiner Daten
            zur Bearbeitung meiner Anfrage zu.
          </span>
        </label>


        <button type="submit" class="submit-button">
          <span>Anfrage senden</span>

          <span class="submit-arrow">↗</span>
        </button>

      </div>

    </form>

  </div>
</section>


<script>
  const fileInput =
    document.querySelector<HTMLInputElement>("#photos");

  const fileList =
    document.querySelector<HTMLDivElement>("#file-list");

  const uploadBox =
    document.querySelector<HTMLLabelElement>("#upload-box");


  const updateFileList = () => {
    if (!fileInput || !fileList) return;

    fileList.innerHTML = "";

    const files = Array.from(fileInput.files ?? []);

    files.forEach((file, index) => {
      const item = document.createElement("div");

      item.className = "file-item";

      const size =
        file.size < 1024 * 1024
          ? `${Math.round(file.size / 1024)} KB`
          : `${(file.size / 1024 / 1024).toFixed(1)} MB`;

      item.innerHTML = `
        <span>${String(index + 1).padStart(2, "0")}</span>

        <strong>${file.name}</strong>

        <small>${size}</small>
      `;

      fileList.appendChild(item);
    });
  };


  fileInput?.addEventListener(
    "change",
    updateFileList
  );


  ["dragenter", "dragover"].forEach((eventName) => {
    uploadBox?.addEventListener(eventName, () => {
      uploadBox.classList.add("dragging");
    });
  });


  ["dragleave", "drop"].forEach((eventName) => {
    uploadBox?.addEventListener(eventName, () => {
      uploadBox.classList.remove("dragging");
    });
  });
</script>



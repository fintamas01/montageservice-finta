---
import Icon from "./ui/Icon.astro";
import { navigation, site, telHref } from "../data/site";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isRequestPage = currentPath === "/anfrage";
---

<header class="site-header on-dark" id="site-header" data-menu-open="false">
  <div class="header-bar">
    <a href="/" class="brand" aria-label={`${site.name} – zur Startseite`}>
      <span class="brand-small" aria-hidden="true">Montageservice</span>
      <span class="brand-name" aria-hidden="true">Finta</span>
    </a>

    <nav class="desktop-nav" aria-label="Hauptnavigation">
      <ul>
        {
          navigation.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a
      href="/anfrage"
      class="btn btn--outline-light header-cta"
      aria-current={isRequestPage ? "page" : undefined}
    >
      Anfrage stellen
      <span class="btn__icon"><Icon name="arrow-up-right" size={16} /></span>
    </a>

    <button
      type="button"
      class="menu-toggle"
      id="menu-toggle"
      aria-controls="mobile-menu"
      aria-expanded="false"
    >
      <span class="sr-only" data-menu-label>Menü öffnen</span>
      <span class="menu-toggle-lines" aria-hidden="true">
        <span></span>
        <span></span>
      </span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav aria-label="Mobile Navigation">
      <ol>
        {
          navigation.map((item, index) => (
            <li>
              <a href={item.href}>
                <span class="menu-index" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                {item.label}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="mobile-menu-footer">
      <a href="/anfrage" class="btn btn--sand">
        Montage anfragen
        <span class="btn__icon"><Icon name="arrow-up-right" size={16} /></span>
      </a>

      <div class="mobile-menu-links">
        {
          site.contact.phone && (
            <a href={telHref(site.contact.phone)}>
              <Icon name="phone" size={16} />
              {site.contact.phone}
            </a>
          )
        }
        <a href={site.instagram.url} target="_blank" rel="noopener noreferrer">
          <Icon name="instagram" size={16} />
          Instagram
          <span class="sr-only">(öffnet in neuem Tab)</span>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById("site-header");
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const label = toggle?.querySelector<HTMLElement>("[data-menu-label]");
  const desktopQuery = window.matchMedia("(min-width: 1024px)");

  if (header && toggle && menu) {
    const backgroundRegions = () =>
      Array.from(document.querySelectorAll<HTMLElement>("main, footer, .skip-link"));

    const setOpen = (open: boolean, { restoreFocus = true } = {}) => {
      header.dataset.menuOpen = String(open);
      toggle.setAttribute("aria-expanded", String(open));
      if (label) label.textContent = open ? "Menü schließen" : "Menü öffnen";

      menu.hidden = !open;
      document.documentElement.classList.toggle("menu-locked", open);
      backgroundRegions().forEach((el) => el.toggleAttribute("inert", open));

      if (open) {
        menu.querySelector<HTMLElement>("a")?.focus();
      } else if (restoreFocus) {
        toggle.focus();
      }
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    menu.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) {
        setOpen(false, { restoreFocus: false });
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        setOpen(false);
      }
    });

    desktopQuery.addEventListener("change", (event) => {
      if (event.matches) setOpen(false, { restoreFocus: false });
    });

    const updateScrolled = () => {
      header.classList.toggle("is-scrolled", window.scrollY > 24);
    };

    updateScrolled();
    window.addEventListener("scroll", updateScrolled, { passive: true });
  }
</script>

<style>
  .site-header {
    position: fixed;
    z-index: 100;
    inset: 0 0 auto;
    color: var(--color-on-dark);
  }

  .header-bar {
    position: relative;
    z-index: 2;
    height: var(--header-height);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    padding-inline: var(--gutter);
    border-bottom: 1px solid rgb(255 255 255 / 0.14);
    transition:
      height 0.35s var(--ease-out),
      background-color 0.35s ease,
      border-color 0.35s ease;
  }

  .site-header.is-scrolled .header-bar,
  .site-header[data-menu-open="true"] .header-bar {
    height: var(--header-height-compact);
    background: rgb(20 20 19 / 0.94);
    border-bottom-color: rgb(255 255 255 / 0.08);
  }

  @supports (backdrop-filter: blur(1px)) {
    .site-header.is-scrolled .header-bar {
      background: rgb(20 20 19 / 0.82);
      backdrop-filter: blur(14px);
    }
  }

  .brand {
    justify-self: start;
    display: flex;
    flex-direction: column;
    padding-block: 6px;
    line-height: 1;
  }

  .brand-small {
    color: var(--color-sand);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.26em;
    text-transform: uppercase;
  }

  .brand-name {
    margin-top: 4px;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .desktop-nav ul {
    display: flex;
    gap: clamp(24px, 2.6vw, 44px);
    list-style: none;
  }

  .desktop-nav a {
    position: relative;
    display: inline-block;
    padding-block: 10px;
    color: var(--color-on-dark-muted);
    font-size: 0.9375rem;
    font-weight: 500;
    transition: color var(--duration) ease;
  }

  .desktop-nav a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 4px;
    height: 1px;
    background: var(--color-sand);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease-out);
  }

  .desktop-nav a:hover {
    color: var(--color-white);
  }

  .desktop-nav a:hover::after {
    transform: scaleX(1);
  }

  .header-cta {
    justify-self: end;
    min-height: 48px;
    padding-block: 4px;
    padding-right: 4px;
  }

  .header-cta .btn__icon {
    width: 36px;
    height: 36px;
  }

  .header-cta[aria-current="page"] {
    border-color: var(--color-sand);
  }

  .menu-toggle {
    display: none;
    justify-self: end;
    width: 48px;
    height: 48px;
    margin-right: -10px;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
  }

  .menu-toggle-lines {
    position: relative;
    display: block;
    width: 26px;
    height: 10px;
    margin-inline: auto;
  }

  .menu-toggle-lines span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.35s var(--ease-out);
  }

  .menu-toggle-lines span:first-child {
    top: 0;
  }

  .menu-toggle-lines span:last-child {
    bottom: 0;
  }

  [data-menu-open="true"] .menu-toggle-lines span:first-child {
    transform: translateY(4.25px) rotate(45deg);
  }

  [data-menu-open="true"] .menu-toggle-lines span:last-child {
    transform: translateY(-4.25px) rotate(-45deg);
  }

  /* Mobile menu */

  .mobile-menu {
    position: fixed;
    z-index: 1;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 40px;
    overflow-y: auto;
    padding:
      calc(var(--header-height-compact) + 24px)
      var(--gutter)
      max(28px, env(safe-area-inset-bottom));
    background: var(--color-ink);
    animation: menu-in 0.35s var(--ease-out);
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-menu ol {
    list-style: none;
  }

  .mobile-menu li a {
    display: flex;
    align-items: baseline;
    gap: 18px;
    padding-block: 16px;
    border-bottom: 1px solid var(--color-on-dark-line);
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 9vw, 3.5rem);
    line-height: 1.1;
  }

  .menu-index {
    min-width: 2ch;
    color: var(--color-sand);
    font-family: var(--font-body);
    font-size: var(--fs-label);
    letter-spacing: 0.12em;
  }

  .mobile-menu-footer {
    display: grid;
    gap: 24px;
  }

  .mobile-menu-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
  }

  .mobile-menu-links a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    color: var(--color-on-dark-muted);
    font-size: var(--fs-small);
  }

  @keyframes menu-in {
    from {
      opacity: 0;
    }
  }

  @media (max-width: 1023.98px) {
    .header-bar {
      grid-template-columns: 1fr auto;
      height: var(--header-height-compact);
    }

    .desktop-nav,
    .header-cta {
      display: none;
    }

    .menu-toggle {
      display: block;
    }

    .brand-name {
      font-size: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .mobile-menu {
      display: none !important;
    }
  }

  :global(html.menu-locked) {
    overflow: hidden;
  }
</style>

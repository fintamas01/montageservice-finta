    transition:
      height 0.4s ease,
      background 0.4s ease,
      backdrop-filter 0.4s ease,
      border-color 0.4s ease;
  }


  .site-header.scrolled {
    height: 82px;

    background: rgba(20, 20, 19, 0.86);

    backdrop-filter: blur(18px);

---
import { Picture } from "astro:assets";
import Icon from "./ui/Icon.astro";
import { projects, site } from "../data/site";

const sizes: Record<string, string> = {
  feature: "(min-width: 900px) 62vw, 100vw",
  tall: "(min-width: 900px) 36vw, 100vw",
  standard: "(min-width: 900px) 36vw, (min-width: 600px) 50vw, 100vw",
};
---

<section class="section surface-paper" id="referenzen" aria-labelledby="referenzen-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow">Referenzen</p>
        <h2 class="display-l" id="referenzen-title">
          Ausgewählte Projekte.<br />
          <em>Sauber umgesetzt.</em>
        </h2>
      </div>
      <p class="lead">
        Ein Einblick in unsere Montagearbeiten – von der Küche über
        Einbaumöbel bis zur Innentür.
      </p>
    </div>

    <ul class="project-grid">
      {
        projects.map((project, index) => (
          <li class={`project project--${project.layout}`} data-reveal data-reveal-delay={index % 2}>
            <figure>
              <Picture
                src={project.image}
                alt={project.alt}
                formats={["avif", "webp"]}
                widths={[480, 800, 1200, 1600]}
                sizes={sizes[project.layout]}
                class="project-image"
              />
              <figcaption>
                <span>{project.category}</span>
                <strong>{project.title}</strong>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>

    <div class="portfolio-footer" data-reveal>
      <span class="portfolio-line" aria-hidden="true"></span>
      <a href={site.instagram.url} target="_blank" rel="noopener noreferrer" class="text-link">
        <Icon name="instagram" size={16} />
        Weitere Arbeiten auf Instagram
        <span class="sr-only">(öffnet in neuem Tab)</span>
        <Icon name="arrow-up-right" size={16} />
      </a>
    </div>
  </div>
</section>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-rows: clamp(220px, 22vw, 320px);
    gap: 16px;
    list-style: none;
  }

  .project--feature {
    grid-column: span 8;
    grid-row: span 2;
  }

  .project--tall {
    grid-column: span 4;
    grid-row: span 2;
  }

  .project--standard {
    grid-column: span 6;
    grid-row: span 2;
  }

  .project figure {
    position: relative;
    isolation: isolate;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius);
    background: #3a3631;
  }

  .project figure::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(15 15 14 / 0) 50%, rgb(15 15 14 / 0.78) 100%);
    pointer-events: none;
  }

  .project :global(.project-image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--ease-out);
  }

  .project:hover :global(.project-image) {
    transform: scale(1.04);
  }

  .project figcaption {
    position: absolute;
    z-index: 1;
    left: 0;
    right: 0;
    bottom: 0;
    display: grid;
    gap: 6px;
    padding: clamp(20px, 2.4vw, 32px);
    color: var(--color-white);
  }

  .project figcaption span {
    color: var(--color-sand);
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .project figcaption strong {
    font-family: var(--font-display);
    font-size: var(--fs-display-s);
    font-weight: 400;
    line-height: 1.1;
  }

  .portfolio-footer {
    display: flex;
    align-items: center;
    gap: 32px;
    margin-top: 48px;
  }

  .portfolio-line {
    flex: 1;
    height: 1px;
    background: var(--color-line);
  }

  @media (max-width: 899.98px) {
    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: auto;
    }

    .project--feature {
      grid-column: 1 / -1;
      grid-row: auto;
      aspect-ratio: 4 / 3;
    }

    .project--tall,
    .project--standard {
      grid-column: span 1;
      grid-row: auto;
      aspect-ratio: 3 / 4;
    }
  }

  @media (max-width: 599.98px) {
    .project-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .project--tall,
    .project--standard {
      grid-column: 1;
      aspect-ratio: 4 / 5;
    }

    .portfolio-footer {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }

    .portfolio-line {
      display: none;
    }
  }
</style>

---
import { Picture } from "astro:assets";
import { images } from "../data/site";

const values = ["Saubere Arbeit", "Präzise Ausführung", "Persönlicher Kontakt"];
---

<section class="section surface-paper" id="ueber-uns" aria-labelledby="ueber-uns-title">
  <div class="container about">
    <div class="about-media" data-reveal>
      <Picture
        src={images.about}
        alt={images.aboutAlt}
        formats={["avif", "webp"]}
        widths={[480, 800, 1200]}
        sizes="(min-width: 900px) 45vw, 100vw"
        class="about-image"
      />
      <p class="about-badge" aria-hidden="true">
        Handwerk<br /><em>mit Anspruch</em>
      </p>
    </div>

    <div class="about-content" data-reveal data-reveal-delay="1">
      <p class="eyebrow">Über uns</p>

      <h2 class="display-l" id="ueber-uns-title">
        Persönlich.<br />
        Präzise.<br />
        <em>Verlässlich.</em>
      </h2>

      <div class="about-copy">
        <p>
          Gute Montage bedeutet für uns mehr als das Zusammensetzen einzelner
          Teile. Entscheidend sind Präzision, ein sauberes Ergebnis und die
          Aufmerksamkeit für jedes Detail.
        </p>
        <p>
          Ob Küche, Möbel oder Türen – jedes Projekt wird sorgfältig
          geplant und zuverlässig umgesetzt.
        </p>
      </div>

      <ul class="about-values">
        {
          values.map((value, index) => (
            <li>
              <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              {value}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(48px, 8vw, 128px);
  }

  .about-media {
    position: relative;
  }

  .about-media :global(.about-image) {
    width: 100%;
    aspect-ratio: 4 / 5;
    max-height: 760px;
    object-fit: cover;
    border-radius: var(--radius);
  }

  .about-badge {
    position: absolute;
    right: clamp(-32px, -2vw, -12px);
    bottom: 56px;
    padding: 22px 28px;
    background: var(--color-sand);
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 1.625rem;
    line-height: 1.05;
    box-shadow: var(--shadow-soft);
  }

  .about-badge em {
    font-style: italic;
  }

  .about-copy {
    display: grid;
    gap: 20px;
    max-width: 34em;
    margin-top: clamp(32px, 4vw, 52px);
    color: var(--color-text-muted);
    font-size: 1.0625rem;
  }

  .about-values {
    margin-top: clamp(36px, 4vw, 56px);
    list-style: none;
    border-top: 1px solid var(--color-line);
  }

  .about-values li {
    display: grid;
    grid-template-columns: 56px 1fr;
    align-items: center;
    min-height: 64px;
    border-bottom: 1px solid var(--color-line);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .about-values span {
    color: var(--color-accent);
    font-size: var(--fs-label);
    letter-spacing: 0.14em;
  }

  @media (max-width: 899.98px) {
    .about {
      grid-template-columns: 1fr;
    }

    .about-media :global(.about-image) {
      aspect-ratio: 4 / 4.4;
    }

    .about-badge {
      right: 16px;
      bottom: 16px;
      padding: 16px 20px;
      font-size: 1.375rem;
    }
  }
</style>

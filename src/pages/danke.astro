---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/ui/Icon.astro";
import { site } from "../data/site";
---

<Layout
  title="Vielen Dank für Ihre Anfrage | Montageservice Finta"
  description="Ihre Projektanfrage wurde erfolgreich übermittelt."
  noindex
>
  <section class="status-page surface-dark on-dark">
    <div class="container">
      <span class="status-icon" aria-hidden="true"><Icon name="check" size={24} /></span>

      <p class="eyebrow">Anfrage gesendet</p>

      <h1 class="display-l">
        Vielen Dank für<br />
        <em>Ihre Anfrage.</em>
      </h1>

      <p class="lead">
        Ihre Projektanfrage ist bei uns eingegangen. Wir sehen sie uns in Ruhe
        an und melden uns persönlich bei Ihnen.
      </p>

      <div class="actions">
        <a href="/" class="btn btn--sand">
          Zur Startseite
          <span class="btn__icon"><Icon name="arrow-up-right" size={16} /></span>
        </a>
        <a href={site.instagram.url} target="_blank" rel="noopener noreferrer" class="text-link">
          <Icon name="instagram" size={16} />
          Arbeiten auf Instagram ansehen
          <span class="sr-only">(öffnet in neuem Tab)</span>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .status-page {
    min-height: 88svh;
    display: flex;
    align-items: center;
    padding-top: calc(var(--header-height) + 64px);
    padding-bottom: 96px;
  }

  .status-icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    margin-bottom: 40px;
    border: 1px solid rgb(255 255 255 / 0.25);
    border-radius: 50%;
    color: var(--color-sand);
  }

  .lead {
    margin-top: 36px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px 36px;
    margin-top: 40px;
  }
</style>

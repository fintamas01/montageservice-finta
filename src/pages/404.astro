---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/ui/Icon.astro";
---

<Layout
  title="Seite nicht gefunden | Montageservice Finta"
  description="Die angeforderte Seite wurde nicht gefunden. Zurück zur Startseite von Montageservice Finta."
  noindex
>
  <section class="status-page surface-dark on-dark">
    <div class="container">
      <p class="eyebrow">Fehler 404 · Seite nicht gefunden</p>

      <h1 class="display-l">
        Hier gibt es<br />
        <em>nichts zu montieren.</em>
      </h1>

      <p class="lead">
        Die gewünschte Seite existiert nicht oder wurde verschoben. Über die
        Startseite finden Sie alle Leistungen und Referenzen.
      </p>

      <div class="actions">
        <a href="/" class="btn btn--sand">
          Zur Startseite
          <span class="btn__icon"><Icon name="arrow-up-right" size={16} /></span>
        </a>
        <a href="/anfrage" class="text-link">
          Montage anfragen
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .status-page {
    min-height: 88svh;
    display: flex;
    align-items: center;
    padding-top: calc(var(--header-height) + 64px);
    padding-bottom: 96px;
  }

  .lead {
    margin-top: 36px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px 36px;
    margin-top: 40px;
  }
</style>

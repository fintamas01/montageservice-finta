---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Seite nicht gefunden | Montageservice Finta"
  description="Die angeforderte Seite wurde nicht gefunden."
  noindex={true}
>
  <Header />

  <main class="error-page">
    <div class="error-inner">
      <span class="error-number">
        404
      </span>

      <p class="eyebrow">
        Seite nicht gefunden
      </p>

      <h1>
        Hier gibt es<br />
        <em>nichts zu montieren.</em>
      </h1>

      <p class="description">
        Die gewünschte Seite konnte leider nicht gefunden werden.
      </p>

      <a href="/" class="button">
        <span>Zur Startseite</span>
        <span>↗</span>
      </a>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .error-page {
    min-height: 90svh;

    display: flex;
    align-items: center;

    padding:
      170px
      24px
      110px;

    background: var(--anthracite-dark);
    color: white;
  }

  .error-inner {
    width: min(1150px, 100%);
    margin: 0 auto;
  }

  .error-number {
    display: block;

    margin-bottom: 40px;

    color: rgba(255,255,255,.28);

    font-size: 10px;
    letter-spacing: .25em;
  }

  .eyebrow {
    margin-bottom: 25px;

    color: var(--beige);

    font-size: 10px;
    font-weight: 600;

    letter-spacing: .2em;
    text-transform: uppercase;
  }

  h1 {
    font-family: var(--font-display);

    font-size: clamp(65px, 9vw, 135px);
    font-weight: 400;

    line-height: .84;
    letter-spacing: -.045em;
  }

  h1 em {
    color: var(--beige);
    font-weight: 400;
  }

  .description {
    max-width: 450px;

    margin-top: 48px;

    color: rgba(255,255,255,.55);

    font-size: 13px;
    line-height: 1.8;
  }

  .button {
    width: min(260px, 100%);

    display: flex;
    justify-content: space-between;
    align-items: center;

    margin-top: 40px;

    padding: 19px 22px;

    background: var(--beige);
    color: var(--anthracite-dark);

    font-size: 10px;
    font-weight: 600;

    letter-spacing: .1em;
    text-transform: uppercase;
  }
</style>
---
import LegalLayout from "../layouts/LegalLayout.astro";
import Pending from "../components/ui/Pending.astro";
import { site, telHref } from "../data/site";

const { legal, contact } = site;

const incomplete =
  !legal.owner || !legal.street || !legal.postalCodeCity || (!contact.phone && !contact.email);
---

<LegalLayout
  title="Impressum | Montageservice Finta"
  description="Impressum und Anbieterkennzeichnung von Montageservice Finta."
  eyebrow="Rechtliches"
  heading="Impressum"
  incomplete={incomplete}
  updated="November 2026"
>
  <h2>Angaben gemäß § 5 DDG</h2>
  <address>
    <p>
      {site.name}<br />
      Inhaber: <Pending value={legal.owner} label="Vor- und Nachname des Inhabers" /><br />
      <Pending value={legal.street} label="Straße und Hausnummer" /><br />
      <Pending value={legal.postalCodeCity} label="PLZ und Ort" /><br />
      Deutschland
    </p>
  </address>

  <h2>Kontakt</h2>
  <p>
    Telefon:{" "}
    {
      contact.phone ? (
        <a href={telHref(contact.phone)}>{contact.phone}</a>
      ) : (
        <Pending value={null} label="Telefonnummer" />
      )
    }
    <br />
    E-Mail:{" "}
    {
      contact.email ? (
        <a href={`mailto:${contact.email}`}>{contact.email}</a>
      ) : (
        <Pending value={null} label="E-Mail-Adresse" />
      )
    }
  </p>

  {
    legal.vatId && (
      <>
        <h2>Umsatzsteuer-ID</h2>
        <p>Umsatzsteuer-Identifikationsnummer gemäß § 27 a Umsatzsteuergesetz: {legal.vatId}</p>
      </>
    )
  }

  <h2>Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV</h2>
  <p>
    <Pending value={legal.owner} label="Vor- und Nachname" /><br />
    Anschrift wie oben
  </p>

  <h2>Haftung für Links</h2>
  <p>
    Diese Website enthält Links zu externen Websites Dritter (z. B. Instagram),
    auf deren Inhalte wir keinen Einfluss haben. Für die Inhalte der verlinkten
    Seiten ist stets der jeweilige Anbieter oder Betreiber verantwortlich.
    Bei Bekanntwerden von Rechtsverletzungen werden wir derartige Links
    umgehend entfernen.
  </p>

  <h2>Urheberrecht</h2>
  <p>
    Die auf dieser Website veröffentlichten Inhalte und Fotos unterliegen dem
    deutschen Urheberrecht. Eine Verwendung außerhalb der Grenzen des
    Urheberrechts bedarf der vorherigen schriftlichen Zustimmung.
  </p>
</LegalLayout>

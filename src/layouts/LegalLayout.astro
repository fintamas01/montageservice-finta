---
import Layout from "./Layout.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/ui/Icon.astro";

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  /** true, solange Pflichtangaben fehlen – zeigt einen Hinweis an. */
  incomplete?: boolean;
  updated: string;
}

const { title, description, eyebrow, heading, incomplete = false, updated } = Astro.props;
---

<Layout title={title} description={description}>
  <PageHero eyebrow={eyebrow} title={heading} size="compact" />

  <section class="section surface-paper legal-section">
    <div class="container--narrow legal-content">
      {
        incomplete && (
          <div class="legal-notice" role="note">
            <Icon name="alert" size={20} />
            <p>
              <strong>Hinweis:</strong> Einige Pflichtangaben werden derzeit
              noch ergänzt.
            </p>
          </div>
        )
      }

      <slot />

      <p class="legal-updated">Stand: {updated}</p>
    </div>
  </section>
</Layout>

<style>
  .legal-section {
    padding-top: clamp(56px, 7vw, 96px);
  }

  .legal-notice {
    display: flex;
    gap: 14px;
    margin-bottom: 48px;
    padding: 18px 22px;
    border-left: 3px solid var(--color-accent);
    background: var(--color-sand-light);
  }

  .legal-notice :global(.icon) {
    flex: none;
    margin-top: 3px;
    color: var(--color-accent);
  }

  .legal-content :global(h2) {
    margin: 56px 0 16px;
    font-family: var(--font-display);
    font-size: var(--fs-display-s);
    font-weight: 400;
    line-height: 1.15;
  }

  .legal-content :global(h2:first-of-type) {
    margin-top: 0;
  }

  .legal-content :global(h3) {
    margin: 32px 0 10px;
    font-size: 1rem;
    font-weight: 600;
  }

  .legal-content :global(p),
  .legal-content :global(li) {
    color: var(--color-text-muted);
  }

  .legal-content :global(p + p) {
    margin-top: 14px;
  }

  .legal-content :global(ul) {
    display: grid;
    gap: 6px;
    margin: 14px 0 14px 1.25em;
  }

  .legal-content :global(a) {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }

  .legal-content :global(address) {
    font-style: normal;
  }

  .legal-updated {
    margin-top: 64px;
    padding-top: 20px;
    border-top: 1px solid var(--color-line);
    font-size: var(--fs-small);
  }
</style>

# Wird beim Build nach dist/api/.htaccess kopiert.
# Nur der Formular-Endpunkt ist öffentlich erreichbar.

Options -Indexes

<IfModule mod_authz_core.c>
  Require all denied
  <Files "send-request.php">
    Require all granted
  </Files>
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>
